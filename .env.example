# Copy to .env (same folder) and fill in. .env is gitignored — never commit it.
# On Render, set these under the service's Environment tab instead.

# Supabase → Connect → Session pooler, with your database password in place of [YOUR-PASSWORD]
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres


# Optional locally (a dev default is used when unset); required on Render
# JWT_SECRET=
